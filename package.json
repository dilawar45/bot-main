{
  "name": "huzaifa-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --filter @huzaifa/web dev",
    "dev:gateway": "pnpm --filter @huzaifa/gateway dev",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "import:products": "pnpm --filter @huzaifa/web import:catalog"
  }
}
