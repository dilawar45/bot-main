PORT=3001
HOST=0.0.0.0
BRAIN_BASE_URL=https://your-app.vercel.app
GATEWAY_HMAC_SECRET=replace-with-the-same-32-character-secret-as-vercel
GATEWAY_ADMIN_TOKEN=replace-with-at-least-32-random-characters
WHATSAPP_AUTH_PATH=/data/wwebjs-auth
WEBHOOK_TIMEOUT_MS=45000
MERGE_WINDOW_MS=2500
# Supabase project URL (required): product photos are only downloaded from here.
PRODUCT_MEDIA_ORIGIN=https://your-project.supabase.co
# true: the bot ignores people saved in the phone's contacts and stores nothing from their chats
# (for a number that is also someone's personal WhatsApp; a dedicated shop number can leave it false).
IGNORE_SAVED_CONTACTS=false
# How often to ask the brain for order reminders and notes to the owner (ms). 0 turns them off.
FOLLOWUP_INTERVAL_MS=300000
