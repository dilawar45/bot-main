NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer the publishable key; the legacy anon key is used when it is absent.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GATEWAY_HMAC_SECRET=replace-with-at-least-32-random-characters
GATEWAY_ADMIN_TOKEN=replace-with-at-least-32-random-characters
SUPPORT_WA_ID=923001234567@c.us
ADMIN_EMAIL=owner@example.com
STORE_CURRENCY=PKR
# Where the web admin reaches the gateway (server-side only).
GATEWAY_BASE_URL=https://your-gateway.up.railway.app
# Vercel Cron sends this as a Bearer token to /api/cron/cleanup-media (at least 16 chars).
CRON_SECRET=replace-with-a-random-secret
# Gemini: one key or several comma-separated keys (rotated, with failover on rate limits).
GEMINI_API_KEY=key-one,key-two
# Stronger model: writes the replies and reads photos.
GEMINI_MODEL_PRO=gemini-flash-latest
# Extra models tried (in order) when the one above is slow or overloaded.
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash
# Fast, cheap model: chat summaries, and the last resort for replies.
GEMINI_MODEL_FAST=gemini-flash-lite-latest
# Meaning search (needs migration 202609290004). After changing it: Products → Update search index.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Photo search: matches customers' photos (e.g. screenshots of your posts) to product photos. Needs a multimodal
# embedding model and migration 202610060002. After changing it: Products → Update search index.
# GEMINI_IMAGE_EMBEDDING_MODEL=gemini-embedding-2
# Public address of this app, for links in the owner's new-order alerts (Vercel's URL is used when unset).
# APP_BASE_URL=https://shop.example.com
